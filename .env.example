# Copy this file to .env and fill in local values.
# .env is git-ignored and must never be committed.

DEMO_BASE_URL=https://demowebshop.tricentis.com/

# Dedicated demo test account created by TC-001.
# Use a unique address that is not linked to any real personal account.
DEMO_EMAIL=your-test-account@example.com
DEMO_PASSWORD=change-me

# Optional: browser override. Leave empty to use the default (Brave).
# Example: /opt/brave-bin/brave
BROWSER_BINARY=
